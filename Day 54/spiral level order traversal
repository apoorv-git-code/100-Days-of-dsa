Problem Statement:
Perform zigzag (spiral) level order traversal of a binary tree. Alternate levels should be traversed left-to-right and right-to-left.

Input Format:
- First line contains integer N
- Second line contains level-order traversal (-1 indicates NULL)

Output Format:
- Print traversal in zigzag order

Example:
Input:
7
1 2 3 4 5 6 7

Output:
1 3 2 4 5 6 7

Explanation:
Level 1 is printed left-to-right, level 2 right-to-left, and so on.

-----------------------------------------------------------------------------------------------------------------------------------------------

#include <stdio.h>
#include <stdlib.h>

// Definition for a binary tree node.
struct TreeNode {
    int val;
    struct TreeNode* left;
    struct TreeNode* right;
};

// Function to build a binary tree from level-order array
struct TreeNode* buildTree(int* arr, int n) {
    if (n <= 0 || arr[0] == -1) return NULL;

    struct TreeNode* root = (struct TreeNode*)malloc(sizeof(struct TreeNode));
    root->val = arr[0];
    root->left = NULL;
    root->right = NULL;

    struct TreeNode** queue = (struct TreeNode**)malloc(n * sizeof(struct TreeNode*));
    int front = 0, rear = 0;
    queue[rear++] = root;

    int i = 1;
    while (i < n && front < rear) {
        struct TreeNode* current = queue[front++];

        if (arr[i] != -1) {
            current->left = (struct TreeNode*)malloc(sizeof(struct TreeNode));
            current->left->val = arr[i];
            current->left->left = NULL;
            current->left->right = NULL;
            queue[rear++] = current->left;
        }
        i++;

        if (i < n && arr[i] != -1) {
            current->right = (struct TreeNode*)malloc(sizeof(struct TreeNode));
            current->right->val = arr[i];
            current->right->left = NULL;
            current->right->right = NULL;
            queue[rear++] = current->right;
        }
        i++;
    }
    free(queue);
    return root;
}

// Function to print the zigzag level order traversal
void zigzagLevelOrder(struct TreeNode* root, int n) {
    if (root == NULL) return;

    struct TreeNode** queue = (struct TreeNode**)malloc((n + 1) * sizeof(struct TreeNode*));
    int front = 0, rear = 0;

    queue[rear++] = root;
    int left_to_right = 1; // 1 for true, 0 for false
    int first_element = 1;

    while (front < rear) {
        int level_size = rear - front;
        int* current_level_vals = (int*)malloc(level_size * sizeof(int));

        for (int i = 0; i < level_size; i++) {
            struct TreeNode* node = queue[front++];
            current_level_vals[i] = node->val;

            if (node->left) queue[rear++] = node->left;
            if (node->right) queue[rear++] = node->right;
        }

        // Print level values based on the traversal direction
        if (left_to_right) {
            for (int i = 0; i < level_size; i++) {
                if (!first_element) printf(" ");
                printf("%d", current_level_vals[i]);
                first_element = 0;
            }
        } else {
            for (int i = level_size - 1; i >= 0; i--) {
                if (!first_element) printf(" ");
                printf("%d", current_level_vals[i]);
                first_element = 0;
            }
        }

        free(current_level_vals);
        left_to_right = !left_to_right;
    }
    printf("\n");
    free(queue);
}

// Function to free the binary tree
void freeTree(struct TreeNode* root) {
    if (root == NULL) return;
    freeTree(root->left);
    freeTree(root->right);
    free(root);
}

int main() {
    int n;
    if (scanf("%d", &n) != 1) return 0;

    int* arr = (int*)malloc(n * sizeof(int));
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    struct TreeNode* root = buildTree(arr, n);

    zigzagLevelOrder(root, n);

    freeTree(root);
    free(arr);
    return 0;
}
