Problem: Count Leaf Nodes

Implement the solution for this problem.

Input:
- Input specifications

Output:
- Output specifications

---------------------------------------------

#include <stdio.h>
#include <stdlib.h>

// Definition of a Binary Tree Node
struct Node {
    int data;
    struct Node* left;
    struct Node* right;
};

// Function to create a new node
struct Node* newNode(int data) {
    struct Node* node = (struct Node*)malloc(sizeof(struct Node));
    node->data = data;
    node->left = NULL;
    node->right = NULL;
    return node;
}

// Function to count leaf nodes in a binary tree
int countLeafNodes(struct Node* root) {
    // 1. If tree is empty, return 0
    if (root == NULL) {
        return 0;
    }
    
    // 2. If node has no children, it's a leaf node
    if (root->left == NULL && root->right == NULL) {
        return 1;
    }
    
    // 3. Otherwise, sum the leaf nodes from left and right subtrees
    return countLeafNodes(root->left) + countLeafNodes(root->right);
}

int main() {
    /* Constructing a sample tree:
              1
             / \
            2   3
           / \   \
          4   5   6
       Leaf nodes are 4, 5, and 6. Total = 3.
    */
    struct Node* root = newNode(1);
    root->left = newNode(2);
    root->right = newNode(3);
    root->left->left = newNode(4);
    root->left->right = newNode(5);
    root->right->right = newNode(6);

    printf("Total number of leaf nodes: %d\n", countLeafNodes(root));

    return 0;
}
