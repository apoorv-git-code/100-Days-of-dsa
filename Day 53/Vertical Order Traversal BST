Problem Statement:
Given a binary tree, print its vertical order traversal. Nodes that lie on the same vertical line should be printed together from top to bottom and from left to right.

Input Format:
- First line contains integer N (number of nodes)
- Second line contains N space-separated integers representing level-order traversal (-1 indicates NULL)

Output Format:
- Print nodes column by column from leftmost to rightmost vertical line

Example:
Input:
7
1 2 3 4 5 6 7

Output:
4
2
1 5 6
3
7

Explanation:
Vertical lines are formed based on horizontal distance from root. Nodes sharing the same distance are printed together.

---------------------------------------------------------------------------------------------------------------------------------------------------------------------------

#include <stdio.h>
#include <stdlib.h>

// Definition for a binary tree node.
struct TreeNode {
    int val;
    struct TreeNode* left;
    struct TreeNode* right;
};

// Queue item for BFS traversal
struct QueueItem {
    struct TreeNode* node;
    int hd;
};

// Function to build a binary tree from level-order array
struct TreeNode* buildTree(int* arr, int n) {
    if (n <= 0 || arr[0] == -1) return NULL;

    struct TreeNode* root = (struct TreeNode*)malloc(sizeof(struct TreeNode));
    root->val = arr[0];
    root->left = NULL;
    root->right = NULL;

    struct TreeNode** queue = (struct TreeNode**)malloc(n * sizeof(struct TreeNode*));
    int front = 0, rear = 0;
    queue[rear++] = root;

    int i = 1;
    while (i < n && front < rear) {
        struct TreeNode* current = queue[front++];

        if (arr[i] != -1) {
            current->left = (struct TreeNode*)malloc(sizeof(struct TreeNode));
            current->left->val = arr[i];
            current->left->left = NULL;
            current->left->right = NULL;
            queue[rear++] = current->left;
        }
        i++;

        if (i < n && arr[i] != -1) {
            current->right = (struct TreeNode*)malloc(sizeof(struct TreeNode));
            current->right->val = arr[i];
            current->right->left = NULL;
            current->right->right = NULL;
            queue[rear++] = current->right;
        }
        i++;
    }
    free(queue);
    return root;
}

// Function to perform and print the vertical order traversal
void verticalOrderTraversal(struct TreeNode* root, int n) {
    if (root == NULL) return;

    int offset = n;
    int size = 2 * n + 1;
    int* capacities = (int*)calloc(size, sizeof(int));
    int* counts = (int*)calloc(size, sizeof(int));
    int** verticalValues = (int**)malloc(size * sizeof(int*));

    for (int i = 0; i < size; i++) {
        capacities[i] = 2;
        verticalValues[i] = (int*)malloc(capacities[i] * sizeof(int));
    }

    int min_hd = 0, max_hd = 0;

    // Queue for BFS
    struct QueueItem* q = (struct QueueItem*)malloc((n + 1) * sizeof(struct QueueItem));
    int q_front = 0, q_rear = 0;

    q[q_rear].node = root;
    q[q_rear].hd = 0;
    q_rear++;

    while (q_front < q_rear) {
        struct QueueItem item = q[q_front++];
        struct TreeNode* current = item.node;
        int hd = item.hd;

        if (hd < min_hd) min_hd = hd;
        if (hd > max_hd) max_hd = hd;

        int index = hd + offset;
        if (counts[index] >= capacities[index]) {
            capacities[index] *= 2;
            verticalValues[index] = (int*)realloc(verticalValues[index], capacities[index] * sizeof(int));
        }
        verticalValues[index][counts[index]++] = current->val;

        if (current->left) {
            q[q_rear].node = current->left;
            q[q_rear].hd = hd - 1;
            q_rear++;
        }
        if (current->right) {
            q[q_rear].node = current->right;
            q[q_rear].hd = hd + 1;
            q_rear++;
        }
    }

    // Print the result
    for (int i = min_hd; i <= max_hd; i++) {
        int index = i + offset;
        for (int j = 0; j < counts[index]; j++) {
            printf("%d", verticalValues[index][j]);
            if (j < counts[index] - 1) {
                printf(" ");
            }
        }
        printf("\n");
    }

    // Free all dynamic arrays and queues
    for (int i = 0; i < size; i++) {
        free(verticalValues[i]);
    }
    free(verticalValues);
    free(capacities);
    free(counts);
    free(q);
}

// Function to free the binary tree
void freeTree(struct TreeNode* root) {
    if (root == NULL) return;
    freeTree(root->left);
    freeTree(root->right);
    free(root);
}

int main() {
    int n;
    if (scanf("%d", &n) != 1) return 0;

    int* arr = (int*)malloc(n * sizeof(int));
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    struct TreeNode* root = buildTree(arr, n);

    verticalOrderTraversal(root, n);

    freeTree(root);
    free(arr);
    return 0;
}
