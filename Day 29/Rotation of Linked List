Problem: Rotate Linked List Right by k Places - Implement using linked list with dynamic memory allocation.

Input:
- First line: integer n
- Second line: n space-separated integers
- Third line: integer k

Output:
- Print the linked list elements after rotation, space-separated

Example:
Input:
5
10 20 30 40 50
2

Output:
40 50 10 20 30

Explanation:
Connect last node to head forming circular list. Traverse to (n-k)th node, set next to NULL, update head to (n-k+1)th node.

----------------------------------------------------------------------------------------------------------------------------

#include <stdio.h>
#include <stdlib.h>

// Define the Node structure
struct Node {
    int data;
    struct Node* next;
};

// Function to create a new node
struct Node* newNode(int data) {
    struct Node* temp = (struct Node*)malloc(sizeof(struct Node));
    temp->data = data;
    temp->next = NULL;
    return temp;
}

struct Node* rotateRight(struct Node* head, int k, int n) {
    if (!head || k == 0 || n <= 1) return head;

    // Handle cases where k >= n
    k = k % n;
    if (k == 0) return head;

    // 1. Traverse to the end and link it to head (make it circular)
    struct Node* tail = head;
    while (tail->next != NULL) {
        tail = tail->next;
    }
    tail->next = head;

    // 2. Find the new tail: (n - k - 1) steps from the head
    int stepsToNewTail = n - k;
    struct Node* newTail = tail; 
    while (stepsToNewTail--) {
        newTail = newTail->next;
    }

    // 3. The node after newTail is the new head
    head = newTail->next;
    newTail->next = NULL;

    return head;
}

void printList(struct Node* node) {
    while (node != NULL) {
        printf("%d%s", node->data, node->next ? " " : "");
        node = node->next;
    }
    printf("\n");
}

int main() {
    int n, k, value;
    if (scanf("%d", &n) != 1 || n <= 0) return 0;

    struct Node *head = NULL, *temp = NULL;

    // Build the list
    for (int i = 0; i < n; i++) {
        scanf("%d", &value);
        if (head == NULL) {
            head = newNode(value);
            temp = head;
        } else {
            temp->next = newNode(value);
            temp = temp->next;
        }
    }

    scanf("%d", &k);

    head = rotateRight(head, k, n);
    printList(head);

    return 0;
}
