Problem Statement:
Implement a Min Heap using an array where the smallest element is always at the root.

Supported Operations:
- insert x
- extractMin
- peek

Input Format:
- First line contains integer N
- Next N lines contain heap operations

Output Format:
- Print results of extractMin and peek
- Print -1 if operation cannot be performed

Example:
Input:
6
insert 40
insert 10
insert 30
peek
extractMin
peek

Output:
10
10
30

--------------------------------------------------------------------------------------------

#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define MAX_SIZE 1000

typedef struct {
    int data[MAX_SIZE];
    int size;
} MinHeap;

void swap(int *a, int *b) {
    int temp = *a;
    *a = *b;
    *b = temp;
}

// Moves the element up to maintain heap property
void bubbleUp(MinHeap *hp, int index) {
    while (index > 0 && hp->data[(index - 1) / 2] > hp->data[index]) {
        swap(&hp->data[(index - 1) / 2], &hp->data[index]);
        index = (index - 1) / 2;
    }
}

// Moves the element down to maintain heap property
void bubbleDown(MinHeap *hp, int index) {
    int smallest = index;
    int left = 2 * index + 1;
    int right = 2 * index + 2;

    if (left < hp->size && hp->data[left] < hp->data[smallest])
        smallest = left;
    
    if (right < hp->size && hp->data[right] < hp->data[smallest])
        smallest = right;

    if (smallest != index) {
        swap(&hp->data[index], &hp->data[smallest]);
        bubbleDown(hp, smallest);
    }
}

void insert(MinHeap *hp, int x) {
    if (hp->size >= MAX_SIZE) return;
    hp->data[hp->size] = x;
    bubbleUp(hp, hp->size);
    hp->size++;
}

int peek(MinHeap *hp) {
    if (hp->size <= 0) return -1;
    return hp->data[0];
}

int extractMin(MinHeap *hp) {
    if (hp->size <= 0) return -1;
    
    int minVal = hp->data[0];
    hp->data[0] = hp->data[hp->size - 1];
    hp->size--;
    
    bubbleDown(hp, 0);
    return minVal;
}

int main() {
    MinHeap hp;
    hp.size = 0;
    
    int n;
    if (scanf("%d", &n) != 1) return 0;
    
    char op[20];
    int val;
    
    for (int i = 0; i < n; i++) {
        scanf("%s", op);
        if (strcmp(op, "insert") == 0) {
            scanf("%d", &val);
            insert(&hp, val);
        } else if (strcmp(op, "peek") == 0) {
            printf("%d\n", peek(&hp));
        } else if (strcmp(op, "extractMin") == 0) {
            printf("%d\n", extractMin(&hp));
        }
    }
    
    return 0;
}
