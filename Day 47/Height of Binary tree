#include <stdio.h>
#include <stdlib.h>

// Definition of a Binary Tree Node
struct Node {
    int data;
    struct Node* left;
    struct Node* right;
};

// Function to create a new node
struct Node* newNode(int data) {
    struct Node* node = (struct Node*)malloc(sizeof(struct Node));
    node->data = data;
    node->left = NULL;
    node->right = NULL;
    return node;
}

// Function to find the height of a binary tree
int getHeight(struct Node* root) {
    if (root == NULL) {
        return -1; // Standard convention: Height of empty tree is -1
    } else {
        // Recursively find the height of each subtree
        int leftHeight = getHeight(root->left);
        int rightHeight = getHeight(root->right);

        // Use the larger height and add 1 for the current level
        if (leftHeight > rightHeight) {
            return (leftHeight + 1);
        } else {
            return (rightHeight + 1);
        }
    }
}

int main() {
    // Manually constructing a sample tree
    //       1
    //      / \
    //     2   3
    //    / \
    //   4   5
    struct Node* root = newNode(1);
    root->left = newNode(2);
    root->right = newNode(3);
    root->left->left = newNode(4);
    root->left->right = newNode(5);

    printf("Height of the binary tree is: %d\n", getHeight(root));

    return 0;
}
