Problem: Evaluate Postfix Expression - Implement using linked list with dynamic memory allocation.

Input:
- Postfix expression with operands and operators

Output:
- Print the integer result

Example:
Input:
2 3 1 * + 9 -

Output:
-4

Explanation:
Use stack to store operands, apply operators by popping operands, push result back. Final stack top is result.

---------------------------------------------------------------------------------------------------------------

#include <stdio.h>
#include <stdlib.h>
#include <ctype.h>

// Structure for a Stack Node
struct Node {
    int data;
    struct Node* next;
};

// Global top pointer
struct Node* top = NULL;

// Push: Add a new node at the beginning of the linked list
void push(int val) {
    struct Node* newNode = (struct Node*)malloc(sizeof(struct Node));
    if (!newNode) {
        printf("Heap Overflow\n");
        exit(1);
    }
    newNode->data = val;
    newNode->next = top;
    top = newNode;
}

// Pop: Remove the top node and return its value
int pop() {
    if (top == NULL) {
        printf("Stack Underflow\n");
        exit(1);
    }
    struct Node* temp = top;
    int poppedValue = temp->data;
    top = top->next;
    free(temp);
    return poppedValue;
}

int evaluatePostfix(char* exp) {
    for (int i = 0; exp[i] != '\0'; i++) {
        // Skip whitespace
        if (exp[i] == ' ') continue;

        // If character is a digit, push it to stack
        if (isdigit(exp[i])) {
            push(exp[i] - '0');
        } 
        // If character is an operator
        else {
            int val1 = pop(); // Right operand
            int val2 = pop(); // Left operand
            
            switch (exp[i]) {
                case '+': push(val2 + val1); break;
                case '-': push(val2 - val1); break;
                case '*': push(val2 * val1); break;
                case '/': push(val2 / val1); break;
            }
        }
    }
    return pop();
}

int main() {
    char exp[100];
    printf("Enter postfix expression (e.g., 2 3 1 * + 9 -): ");
    // Using scanset to read the whole line including spaces
    scanf("%[^\n]s", exp);

    int result = evaluatePostfix(exp);
    printf("Result: %d\n", result);

    return 0;
}
